# SQLite is the V1 default. Use a PostgreSQL URL when migrating.
DATABASE_URL=sqlite:///./data/radar.db

# HTTP client for TWSE / TPEx adapters
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=0.5

TWSE_BASE_URL=https://www.twse.com.tw
TPEX_BASE_URL=https://www.tpex.org.tw
TWSE_OPENAPI_URL=https://openapi.twse.com.tw

# Scoring weights must sum to 1.0
WEIGHT_FLOW=0.30
WEIGHT_ACCELERATION=0.25
WEIGHT_PRICE_MOMENTUM=0.15
WEIGHT_VOLUME_EXPANSION=0.15
WEIGHT_CONTINUITY=0.10
WEIGHT_MARGIN=0.05
